{
  "appId": "com.alkarrar.mobile",
  "appName": "الكرار للموبايل",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_launcher",
      "iconColor": "#0d9488",
      "sound": "beep.wav"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "BackgroundTask": {
      "enable": true
    },
    "BackgroundRunner": {
      "label": "com.alkarrar.mobile.backgroundsync",
      "src": "runners/background.js",
      "event": "syncOfflineQueue",
      "repeat": true,
      "interval": 10,
      "autoStart": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "directUpdate": false,
      "statsUrl": ""
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
